# Copy to .env (or set in your host) to switch integrations from demo → live.
PORT=5173
# Instagram API with Instagram Login (Business/Creator account, long-lived token)
IG_ACCESS_TOKEN=
# Google Places API (New): rating, total count, latest 5 reviews
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Claude-powered AI concierge (falls back to the built-in assistant when unset)
ANTHROPIC_API_KEY=
# Sync blog posts from the practice's WordPress (off by default in the demo)
BLOG_LIVE=
# Demo expiry date (YYYY-MM-DD). After it, every page shows "This demo has expired".
DEMO_EXPIRES=2026-11-03
# Demo login (defaults: sutton@demo.com / the password shared in the outreach email)
DEMO_USER=
DEMO_PASS=
# Optional: secret used to sign the unlock cookie
SESSION_SECRET=
